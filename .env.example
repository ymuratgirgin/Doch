DATABASE_URL="postgresql://user:password@localhost:5432/doch_dev"
# In production, point this at Neon's UNPOOLED connection (no "-pooler" in
# the hostname). Prisma's migration engine needs a direct, non-pooled
# connection to take its advisory lock — using the pooled URL here causes
# "P1002: timed out trying to acquire a postgres advisory lock" during
# `prisma migrate deploy`. Locally, with no pooler, this is the same URL
# as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/doch_dev"
ANTHROPIC_API_KEY=""
